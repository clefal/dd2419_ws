Panels:
  - Class: rviz_common/Displays
    Help Height: 138
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Status1
        - /Grid1
        - /Path1/Topic1
        - /Map1
        - /TF1
        - /TF1/Frames1
        - /Pose1
