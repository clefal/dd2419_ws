        - /PointStamped1
        - /PointStamped2
        - /PointStamped3
        - /PointStamped4
        - /PointStamped5
        - /PointStamped6
      Splitter Ratio: 0.5277161598205566
    Tree Height: 1156
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Tool Properties
    Expanded:
      - /2D Goal Pose1
      - /Publish Point1
    Name: Tool Properties
    Splitter Ratio: 0.5886790156364441
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
  - Class: rviz_common/Time
    Experimental: false
    Name: Time
    SyncMode: 0
    SyncSource: ""
